{
  "name": "dsh-whale-pet",
  "version": "0.4.0",
  "description": "大肥鱼：DSH 桌宠与 GalGame 对话剧场，支持双语、独立主题和人物音效 / Little Whale: a bilingual DSH companion and visual-novel theatre with independent themes and synthesized character sounds.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "cordis",
    "desktop-pet",
    "galgame"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./assets/*": "./assets/*",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.yml",
    "README.md",
    "CHANGELOG.md",
    "ASSETS_LICENSE.md",
    "CONTRIBUTING.md",
    "docs",
    "install.bat",
    "uninstall.bat"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "scripts": {
    "build": "node build.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "package:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-release.ps1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "react": "*"
  },
  "homepage": "https://github.com/Ewigkeit1203/dsh-whale-pet#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ewigkeit1203/dsh-whale-pet.git"
  },
  "bugs": {
    "url": "https://github.com/Ewigkeit1203/dsh-whale-pet/issues"
  }
}
